{
  "name": "del-wang",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "postinstall": "[ -n \"$CI\" ] || lefthook install",
    "lint": "biome check --write --no-errors-on-unmatched --diagnostic-level=error .",
    "new-changeset": "changeset && changeset version && git push --follow-tags",
    "publish-packages": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@changesets/cli": "catalog:dev",
    "@del-wang/config": "workspace:*",
    "lefthook": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=18"
  }
}
